# Python specific ignores
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/ 

# Environment variables
.env
.venv/ 

# Conda specific ignores
# For generated Conda environments, usually they are outside the project dir
# but if you have them inside, you might want to ignore them
conda-env/

# Downloaded models (pulled at runtime via HuggingFace/Ollama)
models/

# Data files
data/raw/             
data/processed/       
data/embeddings/    

# Generated vector store (rebuilt on first run)
vectorstore/
*.sqlite3
*.bin

# Logs
*.log
logs/

# Operating System Specific
## macOS specific
.DS_Store             
**/.DS_Store
## Windows specific
Thumbs.db             

# VS Code specific ignores
.vscode/

# Editor specific ignores
.flake8
.rag_project_structure-2.md

# Personal files
Notes.docx
*.docx
sandbox.ipynb
